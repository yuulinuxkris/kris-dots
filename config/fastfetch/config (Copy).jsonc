

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/kris/.config/fastfetch/yuu-nixos.png",
        "width": 27,
	"height": 16,
    	"type": "kitty-direct",
	"printRemaining": false,
        "padding": {
            "top": 1
        }
    	},

    "display": {
        "separator": " ",
	"disableLinewrap": true
    },
    "modules": [
	"break",
        "break",
        "break",
	{
            "type": "title",
            "keyWidth": 10,
	    "format": "                          kris@nix~~btw",
            "outputColor": "#ffffff"
        },
	"break",
        {
            "type": "custom",
            "format": "┌───────────────────────────────────────────────────────────────┐",
            "outputColor": "#ffffff"
        },
        "break",
        {
            "type": "os",
	    "key": "                       ",
            "keyColor": "#E89EB8",
	    "format": "NixOS 26 x86_64",
            "outputColor": "#ffffff"
        },
        {

	    "type": "command", // Kernel
	    "text": "r=$(uname -r); echo \"$(uname -s) ${r%%.*}\"",
            "key": "                           ",
            "keyColor": "#E89EB8",
            "outputColor": "#ffffff"
        },
        {
            "type": "packages",
            "format": "{nix-all} (nixpkg)",
            "key": "                        ",
            "keyColor": "#E89EB8",
            "outputColor": "#ffffff"
        },
        {
            "type": "shell",
            "key": "                            ",
	    "format": "fish~",
            "keyColor": "#E89EB8",
            "outputColor": "#ffffff"
        },
        {
            "type": "terminal",
            "key": "                            ",
	    "format": "kitty",
            "keyColor": "#E89EB8",
            "outputColor": "#ffffff"
        },
        {
            "type": "wm",
            "key": "                           ",
	    "format": "niri 26",
            "keyColor": "#E89EB8",
            "outputColor": "#ffffff"
        },
        "break",
	        {
            "type": "custom",
            "format": "└───────────────────────────────────────────────────────────────┘",
            "outputColor": "#ffffff"
        }
    ]
}
